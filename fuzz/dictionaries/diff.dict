# libFuzzer dictionary: the tokens a unified diff is made of.
#
# Without it the fuzzer has to guess "diff --git " byte by byte before it reaches any of the
# parsing code worth exercising. Passed as `-dict=` in .github/workflows/fuzz.yml; keep it in
# step with what src/parser.rs actually recognises.

# File headers
header_diff_git="diff --git "
header_old="--- "
header_new="+++ "
header_old_a="--- a/"
header_new_b="+++ b/"
header_dev_null="/dev/null"
header_index="index "
header_mode="new file mode 100644"
header_deleted="deleted file mode 100644"
header_rename_from="rename from "
header_rename_to="rename to "
header_similarity="similarity index "

# Hunks
hunk_open="@@ -"
hunk_close=" @@"
hunk_full="@@ -1,3 +1,3 @@"
hunk_single="@@ -1 +1 @@"
combined="@@@ -1,1 -1,1 +1,1 @@@"
combined_diff="diff --cc "

# Body markers
add="+"
del="-"
context=" "
no_newline="\\ No newline at end of file"

# Binary patches
binary_git="GIT binary patch"
binary_literal="literal "
binary_delta="delta "

# Encodings
# The parser has branches that only non-ASCII bytes reach: octal escapes inside a git-quoted
# path, a selector whose bytes are not valid UTF-8, the lossy path rendering of `list`, and the
# byte-order marks the input guard names. Without these tokens the fuzzer has to invent the
# high bytes itself, and a defect in the header parser caused by one of them went unfound.
quoted_path="\"a/\\303\\251.txt\""
octal_escape="\\303\\251"
raw_byte="\xff"
bom_utf8="\xef\xbb\xbf"
bom_utf16le="\xff\xfe"
bom_utf16be="\xfe\xff"
nbsp="\xc2\xa0"

# Line endings and separators
crlf="\x0d\x0a"
mail_from="From: "
mail_subject="Subject: [PATCH] "
signature="-- "
